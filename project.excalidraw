    {
      "id": "XmkFYGyqY00z2_W22H120",
      "type": "text",
      "x": -1569.82581634988,
      "y": -62.25302080311735,
      "width": 386.48333740234375,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
