    {
      "id": "XmkFYGyqY00z2_W22H120",
      "type": "text",
      "x": -1569.82581634988,
      "y": -62.25302080311735,
      "width": 386.48333740234375,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "FZaZwgM0bsjaRHLycFfdB",
      "index": "b08zzzzpV",
      "roundness": null,
      "seed": 387329161,
      "version": 512,
      "versionNonce": 146944661,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795789228273,
      "created": 1795635764845,
      "link": null,
      "locked": false,
      "text": "When processing Request, target might\nexecute CGI Call.\n\nConfig example:\n\nlocation /cgi-bin/ {\n    allow_methods GET POST;\n\n    cgi_extension .py;\n    cgi_interpreter /usr/bin/python3;\n}\n\nIn this case, any .py file in /cgi-bin/ is a CGI\nCall and the interpreter is /usr/bin/python3.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "E7WkEFdkGby0y6R3kg5Pu",
      "originalText": "When processing Request, target might execute CGI Call.\n\nConfig example:\n\nlocation /cgi-bin/ {\n    allow_methods GET POST;\n\n    cgi_extension .py;\n    cgi_interpreter /usr/bin/python3;\n}\n\nIn this case, any .py file in /cgi-bin/ is a CGI Call and the interpreter is /usr/bin/python3.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Hct_Lo4JCJo-6ZDVhixbz",
      "type": "rectangle",
